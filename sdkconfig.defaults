CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_IOT_SAMPLE_INTERVAL_MS=1000
# CONFIG_IOT_RELAY_DEMO is not set
# CONFIG_IOT_RELAY_ACTIVE_LOW is not set

# Leave credentials empty in version control. Set them locally in menuconfig.
CONFIG_IOT_WIFI_SSID=""
CONFIG_IOT_WIFI_PASSWORD=""
CONFIG_IOT_WIFI_RETRY_SECONDS=5

CONFIG_IOT_MQTT_ENABLED=y
CONFIG_IOT_MQTT_BROKER_URI=""
CONFIG_IOT_DEVICE_ID="esp32-livingroom-01"
CONFIG_IOT_TELEMETRY_INTERVAL_MS=4000
